# Backend base URL for a built (non-dev-proxy) deployment.
# Unset in dev — the Vite dev server proxies /api to the local backend (see vite.config.ts).
VITE_API_BASE_URL=

# Google OAuth client id for Google Identity Services (public value, safe to commit a placeholder).
# Must match one of the backend's GOOGLE_CLIENT_IDS.
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
